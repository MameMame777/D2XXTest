load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Headers — ftd2xx.h + WinTypes.h
# strip_include_prefix removes "libftd2xx/" so consumers can write:
#   #include "ftd2xx.h"
# ---------------------------------------------------------------------------
cc_library(
    name = "ftd2xx_hdrs",
    hdrs = glob(["libftd2xx/*.h"]),
    strip_include_prefix = "libftd2xx",
)

# ---------------------------------------------------------------------------
# Windows: import library (links against system-installed ftd2xx.dll)
# ---------------------------------------------------------------------------
cc_import(
    name = "_ftd2xx_win",
    interface_library = "ftd2xx.lib",
    system_provided = 1,  # ftd2xx.dll is installed by the FTDI driver (System32)
)

# ---------------------------------------------------------------------------
# Linux: static library (no LD_LIBRARY_PATH needed)
# ---------------------------------------------------------------------------
cc_import(
    name = "_ftd2xx_linux",
    static_library = "libftd2xx.a",
)

# ---------------------------------------------------------------------------
# Unified platform target — depend on this from library code
# ---------------------------------------------------------------------------
cc_library(
    name = "ftd2xx",
    deps = [
        ":ftd2xx_hdrs",
    ] + select({
        "@platforms//os:windows": [":_ftd2xx_win"],
        "//conditions:default": [":_ftd2xx_linux"],
    }),
    linkopts = select({
        "@platforms//os:windows": ["SetupAPI.lib"],
        "//conditions:default": [
            "-lpthread",
            "-ldl",
        ],
    }),
)
