# ---------------------------------------------------------------------------
# .bazelrc — Bazel build flags for D2XXTest
# ---------------------------------------------------------------------------

# Automatically apply platform-specific config (linux / windows / macos)
build --enable_platform_specific_config

# ---------------------------------------------------------------------------
# Linux / GCC
# ---------------------------------------------------------------------------
build:linux --cxxopt=-std=c++20
build:linux --cxxopt=-Wall
build:linux --cxxopt=-Wextra
build:linux --cxxopt=-Werror
# -Wpedantic is intentionally omitted: FTDI WinTypes.h uses anonymous structs
# which are a GNU extension (not ISO C++), so -pedantic would break the SDK headers.

# ---------------------------------------------------------------------------
# Windows / MSVC
# ---------------------------------------------------------------------------
build:windows --cxxopt=/std:c++20
build:windows --cxxopt=/W4
build:windows --cxxopt=/WX
build:windows --cxxopt=/utf-8
# Suppress C4996 (POSIX name deprecation in MSVC)
build:windows --cxxopt=/wd4996
